# Copia este archivo como .env.local y rellena los valores. Nunca subas .env.local a GitHub.

# --- Navegador (públicas, se incluyen en el código del frontend) ---
# Supabase > Project Settings > API Keys: URL del proyecto y clave "publishable" (o la "anon" antigua).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Pon "true" para probar el frontend sin conexión con datos de prueba (no hace falta Supabase).
# Cuentas: elena / david, cualquier contraseña. Nunca la actives en Vercel.
VITE_USE_MOCKS=false

# --- Solo servidor (secretas: configúralas en Vercel, NUNCA con prefijo VITE_) ---
# Clave "secret" (o "service_role" antigua). Permite saltarse RLS: solo la usa la tarea programada.
SUPABASE_SERVICE_ROLE_KEY=
# Cadena aleatoria de 32+ caracteres. Vercel la envía en la cabecera Authorization al ejecutar el cron.
CRON_SECRET=
# API key de https://resend.com (plan gratuito).
RESEND_API_KEY=
# Remitente. Sin dominio propio verificado usa: Estudion <onboarding@resend.dev>
EMAIL_FROM=Estudion <onboarding@resend.dev>
# URL pública de la app, para el enlace del correo.
APP_URL=https://tu-proyecto.vercel.app
